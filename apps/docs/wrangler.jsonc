/**
 * Cloudflare Workers configuration for the Proper UI documentation site.
 *
 * The site is built by the OpenNext Cloudflare adapter (`opennextjs-cloudflare build`),
 * which emits the Worker entry at `.open-next/worker.js` and every static asset at
 * `.open-next/assets`. See apps/docs/DEPLOYMENT.md for the full deploy runbook.
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "properui-docs",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-09-09",
    // `nodejs_compat` is required by the adapter; `global_fetch_strictly_public` makes
    // `fetch()` to the site's own domain go back out through the public internet, which is
    // what Next.js expects when a server component fetches an absolute URL.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    // Next-compatible image optimization, wired to Cloudflare Images by the adapter. The docs
    // site uses plain <img>/SVG rather than next/image today, so nothing hits it — keep it so
    // `/_next/image` works if a page ever starts using next/image.
    "images": {
        "binding": "IMAGES",
    },
    "observability": {
        "enabled": true,
    },

    // Until the properui.dev zone is active, the workers.dev subdomain is the only way to
    // reach a deploy. Remove this once the custom-domain routes below are enabled.
    "workers_dev": true,

    // Custom domains. Re-enable once the `properui.dev` zone is active in this Cloudflare
    // account — the domain is registered at Namecheap but still on its default nameservers,
    // and `wrangler deploy` fails with "Could not find zone" until the move is done.
    // "routes": [
    //     { "pattern": "properui.dev", "custom_domain": true },
    //     { "pattern": "www.properui.dev", "custom_domain": true }
    // ]
}
