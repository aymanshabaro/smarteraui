{
    "name": "smarteraui",
    "private": true,
    "description": "Smartera UI — an accessible React 19 + Tailwind CSS v4 component library, its CLI and its documentation site.",
    "license": "MIT",
    "author": "Ayman Shabaro (https://github.com/aymanshabaro)",
    "homepage": "https://github.com/aymanshabaro/smarteraui#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aymanshabaro/smarteraui.git"
    },
    "bugs": {
        "url": "https://github.com/aymanshabaro/smarteraui/issues"
    },
    "packageManager": "pnpm@9.12.0",
    "engines": {
        "node": ">=20"
    },
    "//engines": "Node 20 builds and tests everything. Deploying the docs site additionally needs Node 22 — wrangler 4 refuses to run on 20 (see apps/docs/DEPLOYMENT.md).",
    "scripts": {
        "dev": "turbo run dev --filter=docs",
        "build": "turbo run build",
        "build:packages": "turbo run build --filter=@smarteraui/ui --filter=smarteraui",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "type-check": "turbo run type-check",
        "prettier": "prettier . --write",
        "prettier:check": "prettier . --check",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build -o ./storybook-static",
        "gen:barrels": "tsx scripts/gen-barrels.ts",
        "gen:nav": "tsx scripts/gen-nav.ts",
        "gen:demos": "tsx scripts/gen-demos.ts",
        "gen:demo-assets": "tsx scripts/gen-demo-assets.ts",
        "gen:variants": "tsx scripts/gen-variants.ts",
        "gen:all": "pnpm gen:barrels && pnpm gen:demos && pnpm gen:variant-parts && pnpm gen:variants && pnpm gen:nav && pnpm registry:build",
        "registry:build": "tsx packages/registry/src/build.ts",
        "docs:shot": "tsx scripts/shot.ts",
        "docs:diff": "tsx scripts/diff-shots.ts",
        "shots:thumbs": "tsx scripts/thumbs.ts",
        "check:assets": "tsx scripts/check-no-external-images.ts",
        "changeset": "changeset",
        "release": "changeset publish",
        "gen:variant-parts": "tsx scripts/merge-variant-parts.ts"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.9",
        "@eslint/js": "^9.39.0",
        "@storybook/addon-themes": "^10.5.3",
        "@storybook/nextjs-vite": "^10.5.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^22.9.0",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "next": "^15.1.0",
        "pixelmatch": "^6.0.0",
        "playwright": "^1.56.0",
        "pngjs": "^7.0.0",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.8",
        "storybook": "^10.5.3",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.19.2",
        "turbo": "^2.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
